{
  "name": "until-product-loop",
  "version": "0.2.0",
  "description": "Autonomous product work without manual team coordination: research, priorities, specs, implementation, independent acceptance and outcome-driven cycles. Local-first, model-neutral, MIT.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "until": "bin/until.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./store": "./src/store.js",
    "./policy": "./src/policy.js",
    "./evolve": "./src/evolve.js"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.mjs",
    "proof": "node scripts/proof.mjs",
    "proof:package": "python scripts/package-proof.py",
    "bench": "node scripts/bench.mjs",
    "compare": "node scripts/compare.mjs",
    "compare:report": "node scripts/comparison-report.mjs",
    "demo": "node bin/until.mjs demo",
    "test:report": "node scripts/test-report.mjs",
    "site:dev": "npm --prefix app run dev",
    "site:build": "npm --prefix app run build",
    "validate:site": "node app/scripts/validate.mjs",
    "check": "node scripts/check.mjs && npm test"
  },
  "keywords": [
    "ai-agents",
    "product-management",
    "autonomous-agents",
    "durable-execution",
    "self-improving-agents",
    "evidence",
    "local-first"
  ],
  "author": "Anton Balanov",
  "repository": {
    "type": "git",
    "url": "https://github.com/Balanov/until.git"
  }
}
