    "content": "{\n  \"goalId\": \"bench-returning\",\n  \"opportunityId\": \"opp_bb634628-de66-41bb-81ce-9c09dc859ec5\",\n  \"status\": \"implemented\",\n  \"evidenceIds\": [\n    \"sig_returning\"\n  ],\n  \"implementation\": {\n    \"implementation\": {\n      \"feature\": \"save-progress\",\n      \"mechanism\": {\n        \"server_side\": {\n          \"storage\": \"session-store\",\n          \"tables\": [\n            {\n              \"name\": \"onboarding_progress\",\n              \"columns\": [\n                \"user_id\",\n                \"flow_id\",\n                \"step\",\n                \"data\",\n                \"timestamp\"\n              ]\n            }\n          ]\n        }\n      },\n      \"frontend\": {\n        \"checkpointing\": {\n          \"strategy\": \"step-based\",\n          \"resumption\": {\n            \"trigger\": \"page_reload\",\n            \"method\": \"resume_flow_from_step\"\n          }\n        }\n      }\n    },\n    \"experiment\": {\n      \"bounded\": true,\n      \"scope\": [\n        \"server_side\",\n        \"frontend\"\n      ],\n      \"verification\": false\n    }\n  }\n}",
